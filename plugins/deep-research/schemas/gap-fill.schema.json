{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gap Fill Record",
  "description": "追加調査を Finding 単位に限定し、調査範囲の無制限な拡大を防ぐための記録。",
  "type": "object",
  "required": ["run_id", "gaps"],
  "properties": {
    "run_id": { "type": "string" },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gap_id", "finding_id", "queries", "new_source_ids", "impact", "status"],
        "properties": {
          "gap_id": { "type": "string", "pattern": "^G-[0-9]{3,}$" },
          "finding_id": {
            "description": "この追加調査が対応する Reviewer 指摘。無い調査は範囲外。",
            "type": "string", "pattern": "^F-[0-9]{3,}$"
          },
          "queries": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "new_source_ids": { "type": "array", "items": { "type": "string" } },
          "affected_claim_ids": { "type": "array", "items": { "type": "string" } },
          "impact": {
            "description": "新規情報が既存の主張へ与えた影響。",
            "type": "string", "minLength": 1
          },
          "status": { "type": "string", "enum": ["resolved", "partially-resolved", "unresolved"] }
        }
      }
    }
  }
}
