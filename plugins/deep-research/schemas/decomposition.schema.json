{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Query Decomposition",
  "type": "object",
  "required": ["run_id", "atomic_items"],
  "properties": {
    "run_id": { "type": "string" },
    "ambiguous_terms": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "atomic_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "question", "importance", "evidence_required", "output_section", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^Q-[0-9]{2,}$" },
          "question": { "type": "string", "minLength": 1 },
          "importance": { "type": "string", "enum": ["high", "medium", "low"] },
          "evidence_required": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "output_section": { "type": "string", "minLength": 1 },
          "status": { "type": "string",
            "enum": ["uncovered", "collecting", "covered", "drafted", "verified", "unresolved"] }
        }
      }
    }
  }
}
