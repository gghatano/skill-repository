{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Execution Contract",
  "description": "実行条件。解くべき問い（query.md）とは分離して保持する。",
  "type": "object",
  "required": ["output_path", "output_format", "language", "citation_style", "prohibitions"],
  "properties": {
    "output_path": { "type": "string" },
    "output_format": { "type": "string", "enum": ["markdown", "markdown-report", "summary"] },
    "language": { "type": "string" },
    "citation_style": { "type": "string", "enum": ["inline-url", "numbered", "footnote"] },
    "target_words": { "type": "integer", "minimum": 0 },
    "required_sections": { "type": "array", "items": { "type": "string" } },
    "prohibitions": { "type": "array", "items": { "type": "string" } },
    "deadline": { "type": "string" },
    "scope_note": { "type": "string" },
    "amendments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "by", "change", "reason"],
        "properties": {
          "at": { "type": "string" }, "by": { "type": "string" },
          "change": { "type": "string" }, "reason": { "type": "string" }
        }
      }
    }
  }
}
