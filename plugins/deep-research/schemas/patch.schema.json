{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Patch Plan / Applied Patches",
  "description": "patches/patch-plan.json と patches/applied-patches.json が共有する形。",
  "type": "object",
  "required": ["run_id", "kind", "patches"],
  "properties": {
    "run_id": { "type": "string" },
    "kind": { "type": "string", "enum": ["plan", "applied"] },
    "max_total_changed_ratio": { "type": "number", "minimum": 0 },
    "patches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["patch_id", "finding_ids", "target_file", "target_section",
                     "operation", "before_summary", "after_summary",
                     "max_changed_lines", "status"],
        "properties": {
          "patch_id": { "type": "string", "pattern": "^P-[0-9]{3,}$" },
          "finding_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "target_file": { "type": "string", "minLength": 1 },
          "target_section": { "type": "string", "minLength": 1 },
          "operation": { "type": "string", "enum": ["replace", "insert", "delete"] },
          "before_summary": { "type": "string", "minLength": 1 },
          "after_summary": { "type": "string", "minLength": 1 },
          "max_changed_lines": { "type": "integer", "minimum": 1 },
          "changed_lines": {
            "description": "kind が applied のとき、実際に変更した行数。",
            "type": "integer", "minimum": 0
          },
          "status": { "type": "string",
            "enum": ["planned", "applied", "skipped", "escalated"] },
          "escalation_reason": { "type": "string" }
        }
      }
    }
  }
}
